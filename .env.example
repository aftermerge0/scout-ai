# =========================================================================
# Scout environment
#
# Copy to .env and fill in. Blank values count as "not set" (lib/env.ts
# strips empty strings), so you can leave anything you don't need yet.
#
# Check what's still missing at any time:
#   curl localhost:3000/api/v1/health
# =========================================================================

# --- Mode ---------------------------------------------------------------
# stub = deterministic in-memory pipeline. No keys, no DB, no Inngest.
# live = real collectors + Azure agents + Postgres + Inngest.
SCOUT_API_MODE=stub


# =========================================================================
# REQUIRED FOR SCOUT_API_MODE=live
# =========================================================================

# --- Database -----------------------------------------------------------
# Neon Postgres pooled connection string.
# Also read by `prisma generate`, so it must be present at build time too.
# Get it: https://console.neon.tech -> your project -> Connection string
# Then run: bun run db:push
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# --- Firecrawl (official-source crawling) -------------------------------
# Get it: https://firecrawl.dev -> Dashboard -> API Keys
FIRECRAWL_API_KEY=
# Only for self-hosted Firecrawl. Leave blank for the hosted API.
FIRECRAWL_API_URL=

# --- Exa (third-party signal search) ------------------------------------
# Get it: https://dashboard.exa.ai -> API Keys
EXA_API_KEY=

# --- Azure OpenAI (the 11 section agents) -------------------------------
# Get these: Azure Portal -> your Azure OpenAI resource -> Keys and Endpoint
AZURE_OPENAI_API_KEY=
# Format depends on which kind of resource you have. @ai-sdk/azure only
# appends /v1 when the hostname ends in .openai.azure.com; anything else is
# treated as a custom gateway and used verbatim.
#   Azure OpenAI:  https://my-resource.openai.azure.com/openai
#                  (SDK appends /v1 and the api-version param)
#   AI Foundry:    https://my-resource.services.ai.azure.com/openai/v1
#                  (used as-is, so include /v1 yourself)
AZURE_OPENAI_ENDPOINT=
# Your *deployment* name, not the model id. A deployment of gpt-4o might be
# called "scout-gpt4o"; that is what goes here.
AZURE_OPENAI_DEPLOYMENT=
# Optional. Omit to use the SDK default.
AZURE_OPENAI_API_VERSION=


# =========================================================================
# OPTIONAL
# =========================================================================

# --- Inngest ------------------------------------------------------------
# Leave both blank locally: `bun run inngest` starts the dev server and
# inngest/client.ts forces dev mode when NODE_ENV !== production.
# Both are required in production.
# Get them: https://app.inngest.com -> Environments -> Event/Signing keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Frontend -----------------------------------------------------------
# true = the UI runs entirely off lib/api/mocks.ts and never calls the API.
NEXT_PUBLIC_USE_API_MOCKS=false
# Only when the API lives on a different origin than the app.
NEXT_PUBLIC_API_BASE=

# --- Azure OpenAI for lib/ai.ts -----------------------------------------
# A second, separate Azure provider used by lib/ai.ts (not the evaluation
# pipeline). Can point at the same resource. Note this one takes a bare
# resource *name*, not a URL.
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_DEPLOYMENT_NAME=

# --- Tuning (defaults shown) --------------------------------------------
SCOUT_RATE_LIMIT_PER_MINUTE=5
SCOUT_DEDUPE_WINDOW_HOURS=24
