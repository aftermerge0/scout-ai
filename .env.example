# Copy to .env and fill in real values.
# Every var here is read through lib/env.ts (zod-validated). All are optional
# at the schema level so `bun run dev` works out of the box in stub mode —
# but SCOUT_API_MODE=live requires DATABASE_URL, and each collector/agent
# capability (Firecrawl/Exa/Azure) degrades gracefully if its own keys are
# missing rather than crashing the whole pipeline (see docs/PLAN.md Phase 2).

# --- Database (Neon Postgres) — required for SCOUT_API_MODE=live ---
DATABASE_URL="postgresql://user:password@localhost:5432/scout?schema=public"

# --- Firecrawl (official sources) ---
FIRECRAWL_API_KEY=
# Only needed for a self-hosted Firecrawl instance; defaults to the public API.
FIRECRAWL_API_URL=

# --- Exa (external sources) ---
EXA_API_KEY=

# --- Azure OpenAI (reasoning agents, lib/azure-openai.ts) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Azure OpenAI (frontend AI chat feature, lib/ai.ts — separate from the
# evaluation pipeline above; can point at the same Azure resource) ---
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_DEPLOYMENT_NAME=

# --- Inngest (auto-detects local Dev Server when unset in development) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- API mode: "stub" uses the in-memory simulated pipeline (lib/evaluations/*),
# "live" uses the real Firecrawl/Exa/Azure/Inngest + Prisma pipeline. ---
SCOUT_API_MODE=stub

# --- Phase 4 hardening knobs (optional, sane defaults if unset) ---
# Best-effort in-memory rate limit on POST /api/v1/evaluations (per IP, per minute).
SCOUT_RATE_LIMIT_PER_MINUTE=5
# Dedupe window for returning a cached completed evaluation for the same domain.
SCOUT_DEDUPE_WINDOW_HOURS=24
